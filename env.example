# ThinkZet AI - environment template.
# Copy to app/.env and fill in. Never commit the real file.

# ---- Server ----
PORT=4173
HOST=0.0.0.0
# Public origin. Set this in production so email links resolve correctly.
APP_URL=https://thinkzet.com

# ---- Stripe ----
# sk_test_ for testing, sk_live_ for real money. Live keys require STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://thinkzet.com/?checkout=success
STRIPE_CANCEL_URL=https://thinkzet.com/?checkout=cancelled
STRIPE_ALLOW_LIVE=false

# ---- Email ----
# Resend takes priority; Postmark is the fallback. With neither, messages go to the outbox.
RESEND_API_KEY=
POSTMARK_API_KEY=
EMAIL_FROM=ThinkZet AI <brief@thinkzet.com>
EMAIL_REPLY_TO=
EMAIL_UNSUB_SECRET=change-me-in-production

# ---- OAuth ----
# Google: both values are required for the provider to appear as live.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: all four are required. APPLE_PRIVATE_KEY accepts a PEM with real newlines, literal \n,
# surrounding quotes, or a bare base64 body; it is normalised on read.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Model provider (optional) ----
# Any OpenAI-compatible chat completions endpoint. Without these the copilot and cover
# letters fall back to the deterministic composer.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
